@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="account-page">
    <a href="@Url.Action("Index", "Home")" class="account-back" aria-label="Volver al inicio">←</a>

    <div class="account-shell">
        <div class="account-card">
            <form method="post" action='@Url.Action("Login","Account")' class="account-form">
                <h1>Iniciar sesión</h1>

                <div>
                    <label for="usuarioLogin">Usuario</label>
                    <input id="usuarioLogin" type="text" name="usuario" required />
                </div>

                <div>
                    <label for="passwordLogin">Contraseña</label>
                    <input id="passwordLogin" type="password" name="password" required />
                </div>

                <button type="submit">Ingresar</button>

                @if (!string.IsNullOrWhiteSpace(ViewBag.Error as string))
                {
                    <p class="error-message">@ViewBag.Error</p>
                }

                <p class="account-small">¿No tienes una cuenta? <a href='@Url.Action("Register","Account")'>Registrarse</a></p>
            </form>
        </div>
    </div>
</div>


