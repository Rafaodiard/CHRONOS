@{
    ViewData["Title"] = "Registrarse";
}

<div class="account-page">
    <a href="@Url.Action("Index", "Home")" class="account-back" aria-label="Volver al inicio">←</a>

    <div class="account-shell">
        <div class="account-card">
            <form method="post" action='@Url.Action("Register","Account")' id="formRegister" class="account-form">
                <h1>Registrarse</h1>

                @if (ViewBag.Error != null)
                {
                    <p id="errorMessage" class="error-message">@ViewBag.Error</p>
                }
                else
                {
                    <p id="errorMessage"></p>
                }

                <div>
                    <label for="nombreRegister">Nombre</label>
                    <input id="nombreRegister" type="text" name="nombre" required />
                </div>

                <div>
                    <label for="user">Usuario</label>
                    <input id="user" type="text" name="usuario" required />
                </div>

                <div>
                    <label for="contra1">Contraseña</label>
                    <input id="contra1" type="password" name="password" required />
                </div>

                <div>
                    <label for="contra2">Repetir contraseña</label>
                    <input id="contra2" type="password" name="password2" required />
                </div>

                <button type="submit">Crear cuenta</button>

                <p class="account-small">¿Ya tienes una cuenta? <a href="@Url.Action("Index", "Account")">Iniciar sesión</a></p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/Account.js"></script>
}