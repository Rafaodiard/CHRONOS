@{
    ViewData["Title"] = "Juego";
    ViewData["Musica"] = "juego";
    var esIntroduccion = string.Equals(
        Context.Request.Query["introduccion"].ToString(),
        "true",
        StringComparison.OrdinalIgnoreCase
    );
}
<link rel="stylesheet" href="~/css/juego.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Inventario.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Descarga.css" asp-append-version="true" />


<canvas id="juego" style="background-color: green; image-rendering: pixelated;"></canvas>
<aside id="controlesJuego" class="controles-juego" aria-label="Controles">
    <span class="etiqueta-controles">CONTROLES</span>
    <ul>
        <li><span class="tecla-control">W</span><span class="tecla-control">A</span><span class="tecla-control">S</span><span class="tecla-control">D</span> Moverse</li>
        <li><span class="tecla-control">E</span> Interactuar</li>
        <li><span class="tecla-control">TAB</span> Inventario</li>
        <li><span class="tecla-control">ESC</span> Pausa</li>
    </ul>
</aside>
<div id="introduccionAnio" class="introduccion-anio @(esIntroduccion ? "visible" : "")" aria-hidden="true">Año 2147</div>
<div id="transicionEpoca" class="transicion-epoca" aria-hidden="true">
    <p id="transicionEpocaAnio" class="transicion-epoca-anio"></p>
    <h1 id="transicionEpocaNombre"></h1>
</div>
 <div id="dialogo" role="dialog" aria-live="polite" aria-label="Diálogo">
    <div id="textoDialogo">
        <h3 id="nombrePersonaje"></h3>
        <p id="texto"></p>
        <span class="dialogo-ayuda">E / ESPACIO / ENTER para continuar</span>
    </div>
</div>

<div id="menuPalancas" class="menu-palancas" style="display: none;" aria-hidden="true">
    <section class="panel-palancas" role="dialog" aria-modal="true" aria-labelledby="tituloPalancas">
        <div class="cabecera-palancas">
            <div>
                <span class="etiqueta-palancas">MECANISMO</span>
                <h2 id="tituloPalancas">Panel de palancas</h2>
            </div>
            <button id="cerrarPalancas" class="boton-cerrar-palancas" type="button">Cerrar</button>
        </div>
        <p class="instruccion-palancas">Ajustá cada palanca en la posición correcta.</p>
        <div id="listaPalancas" class="lista-palancas"></div>
    </section>
</div>

<div id="menuEngranajes" class="menu-engranajes" style="display: none;" aria-hidden="true">
    <section class="panel-engranajes" role="dialog" aria-modal="true" aria-labelledby="tituloEngranajes">
        <div class="cabecera-engranajes">
            <div>
                <span class="etiqueta-engranajes">REGULADOR</span>
                <h2 id="tituloEngranajes">Máquina de la Revolución Industrial</h2>
            </div>
            <button id="cerrarEngranajes" class="boton-cerrar-engranajes" type="button">Cerrar</button>
        </div>
        <p class="instruccion-engranajes">Sincroniza los engranajes para llevarlos a la posición 0.</p>
        <div id="listaEngranajes" class="lista-engranajes"></div>
    </section>
</div>

<div id="inventario" style="display: none;">
    <h2>Inventario</h2>
    <section aria-labelledby="tituloObjetosInventario">
        <h3 id="tituloObjetosInventario" class="inventario-subtitulo">Objetos</h3>
        <div id="inventarioLista"></div>
    </section>
    <section class="inventario-seccion-fragmentos" aria-labelledby="tituloFragmentosTemporales">
        <div class="inventario-seccion-cabecera">
            <div>
                <span class="inventario-seccion-etiqueta">COLECCION</span>
                <h3 id="tituloFragmentosTemporales">Fragmentos temporales</h3>
            </div>
            <span id="progresoFragmentosTemporales" class="inventario-seccion-progreso"></span>
        </div>
        <div id="fragmentosTemporalesLista" class="fragmentos-temporales-lista"></div>
    </section>
</div>

<div id="menuAcertijo" class="menu-acertijo" style="display: none;">
    <div class="caja-acertijo">
        <div id="tituloAcertijo">ACERTIJO</div>
        <div id="camposAcertijo"></div>
        <p id="mensajeAcertijo" class="mensaje-acertijo"></p>
        <div class="acciones-acertijo">
            <button id="botonAcertijo" type="button" onclick="comprobarAcertijo()">ACEPTAR</button>
            <button type="button" onclick="cerrarAcertijo()">CERRAR</button>
        </div>
    </div>
</div>

<div id="menuMaquinas" class="menu-descarga" style="display: none;" aria-hidden="true">
    <section class="panel-descarga" role="dialog" aria-modal="true" aria-labelledby="tituloMaquina">
        <header class="cabecera-descarga">
            <div>
                <span class="etiqueta-descarga">SALA DE MÁQUINAS</span>
                <h2 id="tituloMaquina">Panel de control</h2>
                <p id="subtituloMaquina" class="subtitulo-descarga"></p>
            </div>
            <button id="cerrarMaquina" class="boton-cerrar-descarga" type="button" onclick="cerrarPanelMaquina()">Cerrar</button>
        </header>
        <div id="contenidoMaquina"></div>
    </section>
</div>

<div id="menuDescarga" class="menu-descarga" style="display: none;" aria-hidden="true">
    <section id="panelDescarga" class="panel-descarga" role="dialog" aria-modal="true" aria-labelledby="tituloDescarga">
        <header class="cabecera-descarga">
            <div>
                <span class="etiqueta-descarga">SISTEMA DE SEGURIDAD</span>
                <h2 id="tituloDescarga">SALA DE ELECTRICIDAD</h2>
                <p class="subtitulo-descarga">Panel de descarga</p>
            </div>
            <button id="cerrarDescarga" class="boton-cerrar-descarga" type="button">Cerrar</button>
        </header>
        <p class="instruccion-descarga">Arrastrá los tramos al tablero y hacé clic sobre un tramo colocado para girarlo. La descarga solo es estable si todos los tramos forman parte del circuito.</p>
        <div class="cuerpo-descarga">
            <div class="circuito-descarga">
                <div class="terminales-descarga terminales-superior">
                    <div id="fuenteEnergia" class="terminal-descarga terminal-fuente">FUENTE</div>
                </div>
                <div id="tableroCircuito" class="tablero-circuito"></div>
                <div class="terminales-descarga terminales-inferior">
                    <div id="descargaEnergia" class="terminal-descarga terminal-salida">DESCARGA</div>
                </div>
            </div>
            <aside class="zona-bandeja" aria-label="Bandeja de tramos">
                <span class="etiqueta-descarga">TRAMOS</span>
                <div id="bandejaPiezas" class="bandeja-piezas"></div>
            </aside>
        </div>
        <div id="estadoCircuito" class="estado-circuito" role="status" aria-live="polite"></div>
    </section>
</div>

<div id="menuPausa" class="menu-pausa" style="display: none;" aria-hidden="true">
    <div class="panel-pausa" role="dialog" aria-modal="true" aria-labelledby="tituloPausa">
        <p class="etiqueta-pausa">PAUSA</p>
        <h2 id="tituloPausa">Chronos</h2>
        <div class="lista-opciones-pausa">
            <button type="button" class="boton-pausa" data-accion="continuar">CONTINUAR</button>
            <button type="button" class="boton-pausa boton-pausa-salir" data-accion="guardar-salir">GUARDAR Y SALIR</button>
        </div>
        <div id="mensajeGuardadoPausa" class="mensaje-guardado-pausa" aria-live="polite">Partida guardada</div>
    </div>
</div>

<div id="menuBiblioteca" class="menu-biblioteca" style="display: none;" aria-hidden="true">
    <section class="biblioteca-panel" role="dialog" aria-modal="true" aria-labelledby="bibliotecaTitulo">
        <p id="narracionBiblioteca" class="narracion-biblioteca">Una antigua placa de piedra llama tu atención.</p>

        <header id="placaBiblioteca" class="placa-biblioteca" tabindex="0" aria-label="Placa de piedra">
            <span class="brillo-placa" aria-hidden="true"></span>
            <p class="inscripcion-biblioteca">
                <span class="linea-inscripcion" style="--linea: 0">Cuando la noche cae sobre estas murallas,</span>
                <span class="linea-inscripcion" style="--linea: 1">el hombre alza los ojos hacia lo alto.</span>
                <span class="linea-inscripcion" style="--linea: 2">Ni la espada ni la corona guardan lo que allí se oculta.</span>
            </p>
            <p class="inscripcion-biblioteca secundaria">
                <span class="linea-inscripcion" style="--linea: 3">Los sabios quisieron medir los astros y darles nombre.</span>
                <span class="linea-inscripcion" style="--linea: 4">Yo solo aprendí que el firmamento guarda más preguntas que respuestas.</span>
            </p>
        </header>

        <span class="ayuda-placa">E / ESPACIO / ENTER para continuar</span>

        <div class="biblioteca-contenido">
            <aside class="lista-libros" aria-label="Libros de la biblioteca">
                <h2 id="bibliotecaTitulo">Catálogo de libros</h2>
                <div id="librosDisponibles"></div>
            </aside>

            <section class="visor-libro" aria-live="polite">
                <div class="visor-libro-cabecera">
                    <h3 id="tituloLibroActual"></h3>
                    <button id="cerrarBiblioteca" class="boton-biblioteca boton-cerrar" type="button" aria-label="Cerrar biblioteca">Cerrar</button>
                </div>
                <article id="paginaLibroActual" class="pagina-libro"></article>
                <div class="controles-libro">
                    <button id="paginaAnterior" class="boton-biblioteca" type="button">Página anterior</button>
                    <span id="contadorPagina"></span>
                    <button id="paginaSiguiente" class="boton-biblioteca" type="button">Página siguiente</button>
                </div>
            </section>
        </div>
    </section>
</div>

<partial name="_FinalJuego" />

@section Scripts {
    <script src="~/js/inventario/objetos.js" asp-append-version="true"></script>
    <script src="~/js/inventario/recogibles.js" asp-append-version="true"></script>
    <script src="~/js/dialogos.js" asp-append-version="true"></script>
    <script src="~/js/palancas.js" asp-append-version="true"></script>
    <script src="~/js/inventario/libros.js" asp-append-version="true"></script>

    <script src="~/js/inventario/inventario.js" asp-append-version="true"></script>
    <script src="~/js/inventario/inventarioUI.js" asp-append-version="true"></script>
    <script src="~/js/interactuables.js" asp-append-version="true"></script>
    <script src="~/js/progreso.js" asp-append-version="true"></script>
    <script src="~/js/engranajes.js" asp-append-version="true"></script>
    <script src="~/js/maquinas.js" asp-append-version="true"></script>
    <script src="~/js/descarga.js" asp-append-version="true"></script>
    <script src="~/js/descargaUI.js" asp-append-version="true"></script>
    <script src="~/js/acertijos.js" asp-append-version="true"></script>
    <script src="~/js/colisiones.js" asp-append-version="true"></script>
    <script src="~/js/jugador.js" asp-append-version="true"></script>
    <script src="~/js/mapa.js" asp-append-version="true"></script>
    <script src="~/js/npc.js" asp-append-version="true"></script>
    <script src="~/js/camara.js" asp-append-version="true"></script>
    <script src="~/js/ambienteVisual.js" asp-append-version="true"></script>
    <script src="~/js/interacciones.js" asp-append-version="true"></script>
    <script src="~/js/indicadores.js" asp-append-version="true"></script>
    <script src="~/js/juego.js" asp-append-version="true"></script>
    <script>
        document.getElementById("cerrarPalancas").addEventListener("click", cerrarMenuPalancas);
        document.getElementById("cerrarEngranajes").addEventListener("click", cerrarMenuEngranajes);

        document.addEventListener("click", async function (evento) {
            const boton = evento.target.closest("[data-accion]");
            if (!boton) {
                return;
            }

            const accion = boton.dataset.accion;

            if (accion === "continuar") {
                cerrarMenuPausa();
                return;
            }

            if (accion === "guardar-salir") {
                const guardado = await guardarEstado();

                if (!guardado) {
                    mostrarErrorGuardadoPausa();
                    return;
                }

                window.location.href = "/Home/Index";
            }
        });
    </script>
}